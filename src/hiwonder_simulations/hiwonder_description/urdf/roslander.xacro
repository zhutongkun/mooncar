<?xml version="1.0" encoding="utf-8"?>
<robot name="hiwonder" xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:property name="mono_type"      value="$(env MONO_TYPE)"/>
    <xacro:if value="${mono_type == 'None'}">
        <xacro:include filename="$(find hiwonder_description)/urdf/roslander_without_arm.urdf.xacro"/>
    </xacro:if>
    <xacro:if value="${mono_type != 'None'}">
        <xacro:include filename="$(find hiwonder_description)/urdf/roslander.urdf.xacro"/>
    </xacro:if>
</robot>
