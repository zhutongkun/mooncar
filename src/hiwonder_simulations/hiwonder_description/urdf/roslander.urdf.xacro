  <!-- end effector link -->
  <link name="end_effector_link" />

  <joint name="end_effector_joint" type="fixed">
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
    <parent link="link4"/>
    <child link="end_effector_link"/>
  </joint>

  <link name="imu_link"/>
  <joint
    name="imu_joint"
    type="fixed">
    <origin
      xyz="-${0.297 - 0.1481 -0.064} 0 ${0.125963557909225 - 0.045}"
      rpy="0 0 ${M_PI}"/>
    <parent
