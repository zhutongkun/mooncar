    type="fixed">
    <origin
      xyz="0.096499 -0.1121 0.010864"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="wheel_front_right_link" />
    <axis
      xyz="0 0 0" />
  </joint>
  <link
