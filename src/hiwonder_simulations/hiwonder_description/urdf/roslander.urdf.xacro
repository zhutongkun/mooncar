        iyz="9.8943E-13"
        izz="2.2868E-06" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://hiwonder_description/meshes/usb_cam_link.STL" />
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin
