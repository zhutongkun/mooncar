<?xml version="1.0"?>

<launch>
    <arg name="app"         default="false"/>
    <arg name="sim"         default="false"/>
    <arg name="master_name"  default="/"/>
    <arg name="robot_name"   default="/" />
    <arg name="frame_prefix"  default="/"/>
    <!--<arg name="node_name" default="yolov5" />-->

    <arg name="classes_file" default="$(find competition)/scripts/navigation_transport/scene_card/model/classes.names"/>
    <arg name="camera_name"  default="astra_camera"/>
    <!--<rosparam file="$(find competition)/config/config.yaml"   command="load"/>-->

    <!--机器人控制节点-->
    <include file="$(find slam)/launch/include/robot.launch">
        <arg name="sim"         value="$(arg sim)"/>
        <arg name="app"         value="$(arg app)"/>
        <arg name="use_joy"     value="true"/>
        <arg name="robot_name"  value="$(arg robot_name)"/>
        <arg name="master_name" value="$(arg master_name)"/>
    </include>

    <node pkg="competition" type="yolov5_scene_card_node.py" name="yolov5_scene_card" output="screen">
        <param name="engine"               value="model/scene_card.engine"/>
        <param name="lib"                  value="model/scene_card_libmyplugins.so"/>
        <param name="conf_thresh"          value="0.6"/>
        <param name="classes_file"         value="$(arg classes_file)"/>
        <param name="camera_name"          value="$(arg camera_name)"/>
        <param name="auto_start"           value="true"/>
        <param name="publish_object_image" value="true"/>
    </node>

</launch>
